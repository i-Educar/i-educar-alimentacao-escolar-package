{
    "name": "buriti/i-educar-alimentacao-escolar-package",
    "description": "Alimentação escolar (TR 5.2) para o i-Educar 2.12.",
    "version": "0.1.0",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": ["ieducar", "buriti", "laguna"],
    "authors": [{"name": "Buriti"}],
    "require": {
        "php": ">=8.3",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "iEducar\\Packages\\BuritiAlimentacaoEscolar\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "iEducar\\Packages\\BuritiAlimentacaoEscolar\\Providers\\AlimentacaoEscolarServiceProvider"
            ]
        },
        "ieducar": {
            "compatible": ["2.12"]
        }
    },
    "config": {
        "sort-packages": true
    }
}
